# Copy to .env.local for `vercel dev`. On Vercel, set these in Project Settings -> Environment Variables.
# Never commit real values.

# REQUIRED. Get a key at https://aistudio.google.com/ (a free tier exists, with usage limits).
GEMINI_API_KEY=

# Optional. Defaults to gemini-flash-latest (Google's alias for the current Flash model).
# Pin a model here if you want predictable behaviour. The model must support the URL context tool.
GEMINI_MODEL=

# Added automatically when you connect an Upstash Redis store from the Vercel Marketplace:
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Optional but recommended on a public URL: if set, adding a website requires this passcode,
# which stops strangers spending your Gemini quota.
ADD_PASSCODE=
